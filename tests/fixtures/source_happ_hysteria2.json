{
  "remarks": "test HAPP Hysteria2 export",
  "dns": {
    "servers": [
      "9.9.9.9"
    ]
  },
  "outbounds": [
    {
      "protocol": "hysteria",
      "settings": {
        "address": "hysteria2.example.test",
        "port": 443,
        "version": 2
      },
      "streamSettings": {
        "network": "hysteria",
        "security": "tls",
        "hysteriaSettings": {
          "auth": "TEST-HYSTERIA2-AUTH-PASSWORD",
          "version": 2,
          "congestion": "bbr"
        },
        "tlsSettings": {
          "allowInsecure": false,
          "alpn": [
            "h3"
          ],
          "serverName": "hysteria2.example.test"
        },
        "quicParams": {
          "initStreamReceiveWindow": 8388608
        }
      },
      "tag": "source-proxy"
    },
    {
      "protocol": "freedom",
      "tag": "source-direct"
    },
    {
      "protocol": "blackhole",
      "tag": "source-block"
    }
  ]
}
